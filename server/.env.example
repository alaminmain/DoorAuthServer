# Database
DATABASE_URL="postgresql://user:password@localhost:5432/doorauth"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Server
PORT=3000
BASE_URL="https://localhost:3000"
NODE_ENV="development"

# Security
MAX_LOGIN_ATTEMPTS=5

# Email Configuration (Mailtrap for development)
EMAIL_HOST="sandbox.smtp.mailtrap.io"
EMAIL_PORT=2525
EMAIL_USER="your-mailtrap-username"
EMAIL_PASS="your-mailtrap-password"
EMAIL_FROM="noreply@doorauth.com"
EMAIL_FROM_NAME="DoorAuth"

# Or use Gmail for testing (less secure app access must be enabled)
# EMAIL_HOST="smtp.gmail.com"
# EMAIL_PORT=587
# EMAIL_USER="your-gmail@gmail.com"
# EMAIL_PASS="your-app-password"

# Or use Ethereal (auto-generated test account)
# EMAIL_HOST="smtp.ethereal.email"
# EMAIL_PORT=587
# EMAIL_USER="auto-generated"
# EMAIL_PASS="auto-generated"
