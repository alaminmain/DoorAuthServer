@page
@model IndexModel
@{
    ViewData["Title"] = "App Dashboard";
}

<div class="text-center">
    <h1 class="display-4 mb-4">DoorAuth Dashboard</h1>
    
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="alert alert-success d-inline-block">
            Welcome back, <strong>@User.Identity.Name</strong>!
        </div>
        
        <div class="mt-5">
            <h3>Your Applications</h3>
            <p class="text-muted mb-4">Select an application to launch (One-Click SSO)</p>
            
            <div class="row justify-content-center">
                @if (Model.Applications.Any())
                {
                    @foreach (var app in Model.Applications)
                    {
                        <div class="col-md-4 mb-4">
                            <div class="card h-100 shadow-sm hover-shadow">
                                <div class="card-body">
                                    <h2 class="card-title text-primary">
                                        <i class="bi bi-app-indicator"></i> @app.Name
                                    </h2>
                                    <p class="card-text">@(string.IsNullOrEmpty(app.Description) ? "No description available." : app.Description)</p>
                                    
                                    @if (!string.IsNullOrEmpty(app.AppUrl))
                                    {
                                        <button onclick="launchApp('@app.AppUrl', '@app.Name')" class="btn btn-primary btn-lg w-100">
                                            Launch App &rarr;
                                        </button>
                                    }
                                    else
                                    {
                                        <button disabled class="btn btn-secondary w-100">URL Not Configured</button>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12">
                        <div class="alert alert-warning">
                            No applications found for your account. Please contact an administrator.
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="mt-5 border-top pt-4">
            <a href="/logout" class="btn btn-danger">Sign Out</a>
        </div>
    }
    else
    {
        <div class="py-5">
            <p class="lead">Please sign in to access your applications.</p>
            <a href="/login" class="btn btn-primary btn-lg px-5 shadow">Sign In with DoorAuth</a>
        </div>
    }
</div>

@* Hidden field to store access token for JavaScript *@
<input type="hidden" id="accessToken" value="@Model.AccessToken" />

<script>
    function launchApp(appUrl, appName) {
        const token = document.getElementById('accessToken').value;
        
        if (!token) {
            alert('No access token found. Please login again.');
            window.location.href = '/login';
            return;
        }
        
        console.log('🚀 Launching app:', appName);
        console.log('📍 Original App URL:', appUrl);
        console.log('📍 Has trailing slash:', appUrl.endsWith('/'));
        console.log('🎫 Token available:', token ? 'Yes' : 'No');
        
        // Remove trailing slash from appUrl to avoid double slashes
        const cleanAppUrl = appUrl.endsWith('/') ? appUrl.slice(0, -1) : appUrl;
        console.log('✨ Cleaned App URL:', cleanAppUrl);
        
        // Construct SSO URL with token
        const ssoUrl = `${cleanAppUrl}/sso?token=${encodeURIComponent(token)}`;
        
        console.log('🔗 Final SSO URL:', ssoUrl);
        console.log('🔍 Check for double slashes:', ssoUrl.includes('//sso') ? '❌ FOUND DOUBLE SLASH!' : '✅ No double slash');
        
        // Replace current window instead of opening new tab
        // This ensures single session context for proper logout
        window.location.href = ssoUrl;
    }
</script>

<style>
    .hover-shadow:hover {
        transform: translateY(-5px);
        transition: all 0.3s ease;
        box-shadow: 0 .5rem 1rem rgba(0,0,0,.15)!important;
    }
</style>
