@page
@model IndexModel
@{
    ViewData["Title"] = "App Dashboard";
}

<div class="text-center">
    <h1 class="display-4 mb-4">DoorAuth Dashboard</h1>
    
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="alert alert-success d-inline-block">
            Welcome back, <strong>@User.Identity.Name</strong>!
        </div>
        
        <div class="mt-5">
            <h3>Your Applications</h3>
            <p class="text-muted mb-4">Select an application to launch (One-Click SSO)</p>
            
            <div class="row justify-content-center">
                @if (Model.Applications.Any())
                {
                    @foreach (var app in Model.Applications)
                    {
                        <div class="col-md-4 mb-4">
                            <div class="card h-100 shadow-sm hover-shadow">
                                <div class="card-body">
                                    <h2 class="card-title text-primary">
                                        <i class="bi bi-app-indicator"></i> @app.Name
                                    </h2>
                                    <p class="card-text">@(string.IsNullOrEmpty(app.Description) ? "No description available." : app.Description)</p>
                                    
                                    @if (!string.IsNullOrEmpty(app.AppUrl))
                                    {
                                        <a href="@app.AppUrl" target="_blank" class="btn btn-primary btn-lg w-100">
                                            Launch App &rarr;
                                        </a>
                                    }
                                    else
                                    {
                                        <button disabled class="btn btn-secondary w-100">URL Not Configured</button>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12">
                        <div class="alert alert-warning">
                            No applications found for your account. Please contact an administrator.
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="mt-5 border-top pt-4">
            <a href="/logout" class="btn btn-danger">Sign Out</a>
        </div>
    }
    else
    {
        <div class="py-5">
            <p class="lead">Please sign in to access your applications.</p>
            <a href="/login" class="btn btn-primary btn-lg px-5 shadow">Sign In with DoorAuth</a>
        </div>
    }
</div>

<style>
    .hover-shadow:hover {
        transform: translateY(-5px);
        transition: all 0.3s ease;
        box-shadow: 0 .5rem 1rem rgba(0,0,0,.15)!important;
    }
</style>
