// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// -------------------
// Core Tenant & User Models
// -------------------

// -------------------
// Registration Status Enum
// -------------------

// Note: SQLite doesn't support native enums, so we use String with validation in code
// Valid values: PENDING, EMAIL_VERIFIED, TENANT_ASSIGNED, COMPLETED, REJECTED, EXPIRED

model Tenant {
  id             String   @id @default(uuid())
  name           String
  domain         String   @unique
  brandingConfig String?
  createdAt      DateTime @default(now()) @map("created_at")

  users                 User[]
  applications          Application[]
  roles                 Role[]
  auditLogs             AuditLog[]
  organizations         Organization[]
  registrationRequests  RegistrationRequest[]

  @@map("tenants")
}

// -------------------
// Registration Request Model (Three-Tier Workflow)
// -------------------

model RegistrationRequest {
  id                      String    @id @default(uuid())
  email                   String    @unique
  fullName                String
  companyName             String?
  contact                 String?
  passwordHash            String
  
  // Status tracking (PENDING, EMAIL_VERIFIED, TENANT_ASSIGNED, COMPLETED, REJECTED, EXPIRED)
  status                  String    @default("PENDING")
  emailVerified           Boolean   @default(false)
  emailVerifiedAt         DateTime? @map("email_verified_at")
  
  // Verification token
  verificationToken       String?   @unique @map("verification_token")
  verificationTokenExpiry DateTime? @map("verification_token_expiry")
  
  // Phase 2: Admin tenant assignment
  assignedTenantId        String?   @map("assigned_tenant_id")
  assignedOrgId           String?   @map("assigned_org_id")
  assignedByAdminId       String?   @map("assigned_by_admin_id")
  assignedAt              DateTime? @map("assigned_at")
  
  // Phase 3: Tenant admin approval
  approvedByTenantAdminId String?   @map("approved_by_tenant_admin_id")
  approvedAt              DateTime? @map("approved_at")
  
  // Rejection tracking
  rejectedBy              String?   @map("rejected_by")
  rejectedAt              DateTime? @map("rejected_at")
  rejectionReason         String?   @map("rejection_reason")
  
  // Metadata
  ipAddress               String?   @map("ip_address")
  userAgent               String?   @map("user_agent")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")
  
  // Relations
  tenant                  Tenant?       @relation(fields: [assignedTenantId], references: [id], onDelete: SetNull)
  organization            Organization? @relation(fields: [assignedOrgId], references: [id], onDelete: SetNull)
  createdUser             User?         @relation("CreatedFromRegistration")
  
  @@index([status])
  @@index([emailVerified])
  @@index([assignedTenantId])
  @@index([createdAt])
  @@map("registration_requests")
}

model User {
  id                 String    @id @default(uuid())
  loginId            String
  userName           String?
  email              String
  passwordHash       String
  companyName        String?
  companyAddress     String?
  designation        String?
  contact            String?
  
  // Approval workflow (CHANGED: default is now false for new registrations)
  isApproved         Boolean   @default(false)
  approvedBy         String?   @map("approved_by")
  approvedAt         DateTime? @map("approved_at")
  
  isLocked           Boolean   @default(false)
  isTwoFactorEnabled Boolean   @default(false)
  twoFactorSecret    String?
  lastLoginTime      DateTime?
  passAttemptCount   Int       @default(0)
  isPassExpired      Boolean   @default(false)
  emailVerified      Boolean   @default(false) @map("email_verified")
  emailVerifiedAt    DateTime? @map("email_verified_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  // Tenant relationship
  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId         String
  
  // Organization
  organization     Organization?    @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  organizationId   String?
  
  // Registration request (links to the original registration request)
  registrationRequest   RegistrationRequest? @relation("CreatedFromRegistration", fields: [registrationRequestId], references: [id], onDelete: SetNull)
  registrationRequestId String?              @unique @map("registration_request_id")
  
  // Other relations
  roles              UserRole[]
  auditLogs          AuditLog[]
  passTokens         PassToken[]
  blacklistedTokens  TokenBlacklist[]
  sessions           Session[]
  emailVerifications EmailVerification[]

  @@unique([tenantId, loginId])
  @@unique([tenantId, email])
  @@index([isApproved])
  @@map("users")
}

model Organization {
  id          String   @id @default(uuid())
  name        String
  description String?
  level       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId String
  parent   Organization?  @relation("OrganizationHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  parentId String?
  children Organization[] @relation("OrganizationHierarchy")
  users    User[]
  registrationRequests RegistrationRequest[]

  @@map("organizations")
}

// -------------------
// Application & SSO Models
// -------------------

model Application {
  id           String   @id @default(uuid())
  name         String
  description  String?
  status       String   @default("active")
  logoUrl      String?
  appUrl       String?
  clientId     String   @unique @default(uuid())
  clientSecret String
  redirectUris String // SQLite does not support arrays (String[]). Storing as comma-separated string or JSON.
  createdAt    DateTime @default(now()) @map("created_at")

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId String
  menus    Menu[]
  roles    Role[]

  @@map("applications")
}

// -------------------
// RBAC (Roles & Permissions)
// -------------------

model Role {
  id          String   @id @default(uuid())
  name        String
  description String?
  isSystem    Boolean  @default(false)
  status      String   @default("active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId      String
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId String?
  users         UserRole[]
  permissions   Permission[]

  @@unique([tenantId, name])
  @@map("roles")
}

model UserRole {
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId String

  @@id([userId, roleId])
  @@map("user_roles")
}

model Permission {
  id       String @id @default(uuid())
  resource String // e.g., "payroll"
  action   String // e.g., "read", "write"

  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId String

  @@unique([roleId, resource, action])
  @@map("permissions")
}

// -------------------
// Dynamic Menu & Security Models
// -------------------

model Menu {
  id                 String  @id @default(uuid())
  label              String
  path               String
  icon               String?
  order              Int
  requiredPermission String? // e.g., "payroll:read"

  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId String
  parent        Menu?       @relation("MenuHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  parentId      String?
  children      Menu[]      @relation("MenuHierarchy")

  @@map("menus")
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  resource  String
  ipAddress String?
  userAgent String?
  details   String?
  createdAt DateTime @default(now()) @map("created_at")

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String

  @@map("audit_logs")
}

model PassToken {
  id            String    @id @default(uuid())
  token         String    @unique
  remarks       String?
  isActive      Boolean   @default(true)
  expireDate    DateTime
  tokenUsedDate DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@map("pass_tokens")
}

// -------------------
// OAuth/OIDC Models
// -------------------

model AuthorizationCode {
  id                  String    @id @default(uuid())
  code                String    @unique
  clientId            String
  userId              String
  redirectUri         String
  scope               String?
  codeChallenge       String?
  codeChallengeMethod String?
  expiresAt           DateTime
  used                Boolean   @default(false)
  usedAt              DateTime?
  createdAt           DateTime  @default(now()) @map("created_at")

  @@map("authorization_codes")
}

model RefreshToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  clientId  String
  scope     String?
  expiresAt DateTime
  revoked   Boolean   @default(false)
  revokedAt DateTime?
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("refresh_tokens")
}

// -------------------
// Token Blacklist (Security)
// -------------------

model TokenBlacklist {
  id         String   @id @default(uuid())
  jti        String   @unique
  userId     String
  tokenType  String
  token      String?
  expiresAt  DateTime
  revokedAt  DateTime @default(now()) @map("revoked_at")
  reason     String?
  revokedBy  String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([jti])
  @@index([userId])
  @@index([expiresAt])
  @@index([tokenType])
  @@map("token_blacklist")
}


// -------------------
// Session Management
// -------------------

model Session {
  id            String    @id @default(uuid())
  userId        String
  sessionToken  String    @unique
  deviceInfo    String?
  browser       String?
  os            String?
  ipAddress     String?
  loginTime     DateTime  @default(now()) @map("login_time")
  lastActivity  DateTime  @default(now()) @map("last_activity")
  expiresAt     DateTime  @map("expires_at")
  isActive      Boolean   @default(true) @map("is_active")
  revokedAt     DateTime? @map("revoked_at")
  revokeReason  String?   @map("revoke_reason")
  createdAt     DateTime  @default(now()) @map("created_at")
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([sessionToken])
  @@index([isActive])
  @@index([expiresAt])
  @@map("sessions")
}

// -------------------
// Email Verification
// -------------------

model EmailVerification {
  id          String    @id @default(uuid())
  userId      String
  token       String    @unique
  email       String
  expiresAt   DateTime  @map("expires_at")
  verifiedAt  DateTime? @map("verified_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([token])
  @@index([userId])
  @@index([email])
  @@map("email_verifications")
}

